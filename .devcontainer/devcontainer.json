{
  "name": "R-for-VSCode (Compose)",
  "dockerComposeFile": [
    "../docker-compose.yml"
  ],
  "service": "r-for-vscode",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
